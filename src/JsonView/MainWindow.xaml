<Window x:Class="JsonView.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="JsonView" Width="1320" Height="850" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen" AllowDrop="True">
  <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,9" Background="{DynamicResource SurfaceBrush}">
      <WrapPanel>
        <TextBlock Text="JsonView" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <Button Content="新建" Click="NewClick" ToolTip="Ctrl+N"/>
        <Button Content="打开…" Click="OpenClick" ToolTip="Ctrl+O · 支持拖入多个文件"/>
        <Button Content="保存" Click="SaveClick" ToolTip="Ctrl+S"/>
        <Button Content="另存为…" Click="SaveAsClick"/>
        <Button Content="格式化" Click="FormatClick"/>
        <Button Content="压缩" Click="CompactClick" ToolTip="压缩会移除注释，可撤销"/>
        <Button Content="插件 ▾" Click="PluginsClick"/>
        <Button x:Name="ThemeButton" Content="切换暗色" Click="ThemeClick"/>
      </WrapPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Padding="16,7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
      <TextBlock x:Name="AppStatus" Text="本地处理 · JSON + 注释 · 支持拖拽文件" Foreground="{DynamicResource MutedBrush}"/>
    </Border>
    <TabControl x:Name="Documents" Margin="14,12,14,10"/>
  </DockPanel>
</Window>
